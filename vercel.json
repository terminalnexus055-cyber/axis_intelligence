{
  "version": 2,
  "routes": [
    { "src": "/api/telegram", "dest": "/api/telegram.js" },
    { "src": "/api/browser", "dest": "/api/browser.js" },
    { "src": "/api/cron", "dest": "/api/cron.js" },
    { "src": "/api/setup", "dest": "/api/setup.js" },
    { "src": "/api/test", "dest": "/api/test.js" },
    { "src": "/api/redisTest", "dest": "/api/redisTest.js" },
    { "src": "/api/redditTest", "dest": "/api/redditTest.js" },
    { "src": "/api/arcticTest", "dest": "/api/arcticTest.js" },
    { "src": "/api/redditDebug", "dest": "/api/redditDebug.js" },
    { "src": "/api/browserTest", "dest": "/api/browserTest.js" },
    { "src": "/api/rssTest", "dest": "/api/rssTest.js" },
    { "src": "/api/videoTest", "dest": "/api/videoTest.js" },
    { "src": "/api/audio", "dest": "/api/audio.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 6 * * *" },
    { "path": "/api/cron", "schedule": "0 13 * * *" }
  ]
}
